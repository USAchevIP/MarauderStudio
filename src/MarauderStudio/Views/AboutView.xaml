<Page x:Class="MarauderStudio.Views.AboutView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:loc="clr-namespace:MarauderStudio.Localization"
      Title="{loc:LocalizedString Nav.About}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:LocalizedString Nav.About}"
                   FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" MaxWidth="600" HorizontalAlignment="Left">

            <Border CornerRadius="12" Padding="20" Margin="0,0,0,16"
                    Background="{DynamicResource SystemControlAcrylicElementBrush}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" CornerRadius="12"
                            Background="{StaticResource MarauderOrangeBrush}">
                        <TextBlock Text="M" FontSize="32" FontWeight="Bold"
                                   Foreground="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:LocalizedString App.Title}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:LocalizedString App.Subtitle}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:LocalizedString About.Description}"
                       TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,16"/>

            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                    Background="{DynamicResource SystemControlAcrylicElementBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:LocalizedString About.Version}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="1.0.0" Opacity="0.7" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                    Background="{DynamicResource SystemControlAcrylicElementBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:LocalizedString About.License}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="MIT" Opacity="0.7" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                    Background="{DynamicResource SystemControlAcrylicElementBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:LocalizedString About.Author}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Ukiterus" Opacity="0.7" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Button Margin="0,24,0,0" Click="RepoButton_OnClick"
                    HorizontalAlignment="Left" Padding="20,8">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Globe" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:LocalizedString About.Repo}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
