<Page x:Class="MarauderStudio.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:loc="clr-namespace:MarauderStudio.Localization"
      xmlns:vm="clr-namespace:MarauderStudio.ViewModels"
      Title="{loc:LocalizedString Nav.Settings}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:LocalizedString Nav.Settings}"
                   FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">

                <Border CornerRadius="8" Padding="16" Margin="0,0,0,12"
                        Background="{DynamicResource SystemControlAcrylicElementBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Globe" Margin="0,0,12,0"/>
                            <TextBlock Text="{loc:LocalizedString Settings.Language}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageCombo" Width="240" HorizontalAlignment="Left"
                                  SelectionChanged="LanguageCombo_OnSelectionChanged">
                            <ComboBoxItem Content="{loc:LocalizedString Language.Ru}" Tag="ru"/>
                            <ComboBoxItem Content="{loc:LocalizedString Language.En}" Tag="en"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Padding="16" Margin="0,0,0,12"
                        Background="{DynamicResource SystemControlAcrylicElementBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Setting" Margin="0,0,12,0"/>
                            <TextBlock Text="{loc:LocalizedString Settings.Theme}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Width="240" HorizontalAlignment="Left"
                                  SelectionChanged="ThemeCombo_OnSelectionChanged">
                            <ComboBoxItem Content="{loc:LocalizedString Settings.Theme.Dark}" Tag="dark"/>
                            <ComboBoxItem Content="{loc:LocalizedString Settings.Theme.Light}" Tag="light"/>
                            <ComboBoxItem Content="{loc:LocalizedString Settings.Theme.System}" Tag="system"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Padding="16" Margin="0,0,0,12"
                        Background="{DynamicResource SystemControlAcrylicElementBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Folder" Margin="0,0,12,0"/>
                            <TextBlock Text="Пути и esptool" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{loc:LocalizedString Settings.EsptoolPath}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EsptoolPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Command="{Binding BrowseEsptoolCommand}" Padding="12,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Folder" Margin="0,0,6,0"/>
                                    <TextBlock Text="…"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding EsptoolDescription}" Opacity="0.6" FontSize="11" Margin="0,4,0,12"/>

                        <TextBlock Text="{loc:LocalizedString Settings.DownloadDir}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DownloadDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Command="{Binding BrowseDownloadDirCommand}" Padding="12,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Folder" Margin="0,0,6,0"/>
                                    <TextBlock Text="…"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Padding="16" Margin="0,0,0,12"
                        Background="{DynamicResource SystemControlAcrylicElementBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Globe" Margin="0,0,12,0"/>
                            <TextBlock Text="WiFi OTA" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{loc:LocalizedString Settings.OtaSsid}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OtaSsid, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="{loc:LocalizedString Settings.OtaPassword}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OtaPassword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Button Margin="0,16,0,0" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left" Padding="24,8">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save" Margin="0,0,8,0"/>
                        <TextBlock Text="{loc:LocalizedString Settings.Save}"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
